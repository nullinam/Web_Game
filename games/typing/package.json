{
  "name": "penko-typing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Retro arcade-style typing game for learning non-Latin keyboard layouts. Master Korean, Russian, Japanese, and 10+ other scripts.",
  "author": "Penko Team",
  "license": "GPL-3.0",
  "homepage": "https://typing.penkosoftware.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NA-Ag/penko-typing.git"
  },
  "keywords": [
    "typing-game",
    "keyboard-layouts",
    "language-learning",
    "korean",
    "russian",
    "japanese",
    "arcade",
    "pwa",
    "retro",
    "hangul",
    "cyrillic",
    "kana",
    "typing-tutor",
    "multilingual"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
}
